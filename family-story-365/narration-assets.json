    {
      "id": "theatre-02",
      "mode": "theatre",
      "file": "theatre-02.mp3",
      "seconds": 7.212766,
      "cues": [
        {
          "start": 0,
          "end": 3.093922902494331,
          "text": "老闆笑著，把霜淇淋交給孩子。"
        },
        {
          "start": 3.443922902494331,
          "end": 6.862766439909297,
          "text": "爸爸和媽媽忙著聊天，忘了付錢。"
        }
      ],
      "sha256": "28df9f9eb1ca7674a6b02978950779dd1d9679c56999d45048ac86eb30ffe7e3"
    },
    {
      "id": "theatre-03",
      "mode": "theatre",
      "file": "theatre-03.mp3",
      "seconds": 12.558277,
      "cues": [
        {
          "start": 0,
          "end": 3.7848526077097504,
          "text": "離開以後，爸爸問：「霜淇淋多少錢？」"
        },
        {
          "start": 4.1348526077097505,
          "end": 6.315170068027211,
          "text": "媽媽問：「不是你付的嗎？」"
        },
        {
          "start": 6.66517006802721,
          "end": 8.823219954648525,
          "text": "原來，大家都忘記了！"
        },
        {
          "start": 9.173219954648525,
          "end": 12.208276643990928,
          "text": "孩子拍手說：「免費的霜淇淋！」"
        }
      ],
      "sha256": "7dc744eb1880e6e05e1597651a064db62c7c7b7d4ef548d2c7a93b3bcdfaf7c0"
    },
    {
      "id": "theatre-04",
      "mode": "theatre",
      "file": "theatre-04.mp3",
      "seconds": 5.559615,
      "cues": [
        {
          "start": 0,
          "end": 2.2865986394557822,
          "text": "爸爸說：「該付的錢，還是要付。」"
        },
        {
          "start": 2.6365986394557823,
          "end": 5.2096145124716555,
          "text": "可是，遊樂場已經關門了。"
        }
      ],
      "sha256": "6dd12b4f440ef992b64dd12d1554a4f25daf27d7b068750609b1f1d8357d7819"
    },
    {
      "id": "theatre-05",
      "mode": "theatre",
      "file": "theatre-05.mp3",
      "seconds": 6.754172,
      "cues": [
        {
          "start": 0,
          "end": 3.018049886621315,
          "text": "「明天打電話，再把錢寄過去。」"
        },
        {
          "start": 3.368049886621315,
          "end": 6.404172335600907,
          "text": "孩子問：「沒有人知道，也要付嗎？」"
        }
      ],
      "sha256": "0339b9cb2fc0d1a6a595b1785b09a11386eb46ecaab08e31a98149eb3bb57239"
    },
    {
      "id": "theatre-06",
      "mode": "theatre",
      "file": "theatre-06.mp3",
      "seconds": 8.6178,
      "cues": [
        {
          "start": 0,
          "end": 2.12,
          "text": "爸爸輕輕摸摸孩子的頭。"
        },
        {
          "start": 2.47,
          "end": 5.030272108843538,
          "text": "「誠實，是我們心中的原則。」"
        },
        {
          "start": 5.3802721088435375,
          "end": 8.26780045351474,
          "text": "沒有人看見，我也選擇誠實。"
        }
      ],
      "sha256": "ca28726fc3139755e793fc5530b349066ae9b96db52bb905e0b4824f93bbb76f"
    },
