    {
      "id": "reader-01",
      "mode": "reader",
      "file": "reader-01.mp3",
      "seconds": 21.867392,
      "cues": [
        {
          "start": 0,
          "end": 4.494784580498866,
          "text": "一對父母帶著孩子，到遊樂場度過快樂的一天。"
        },
        {
          "start": 4.8447845804988665,
          "end": 10.412698412698413,
          "text": "他們買霜淇淋時，一邊和老闆聊天，一邊看著開心的孩子。"
        },
        {
          "start": 10.762698412698413,
          "end": 16.103628117913832,
          "text": "直到離開後，父母才發現，兩個人都以為對方付過錢了。"
        },
        {
          "start": 16.45362811791383,
          "end": 21.517392290249433,
          "text": "孩子以為自己得到了一份免費的點心，開心地拍起手來。"
        }
      ],
      "sha256": "f5f40a50d14cd2e6032d2442645657d2430e9a7fc9e2077f6e9eb502ddd953d9"
    },
    {
      "id": "reader-02",
      "mode": "reader",
      "file": "reader-02.mp3",
      "seconds": 23.016168,
      "cues": [
        {
          "start": 0,
          "end": 5.7942857142857145,
          "text": "父親卻說，該付的錢還是要付。他們應該回去，把錢交給老闆。"
        },
        {
          "start": 6.144285714285714,
          "end": 10.834444444444443,
          "text": "當時，他們已經離開兩個鐘頭，遊樂場也關門了。"
        },
        {
          "start": 11.184444444444445,
          "end": 16.55308390022676,
          "text": "父親想了想，決定明天打電話說明，再把錢寄過去。"
        },
        {
          "start": 16.903083900226758,
          "end": 22.666167800453515,
          "text": "孩子不明白：錢又不多，老闆也忘了，為什麼還要這樣做？"
        }
      ],
      "sha256": "6084008630476a31defb69e7ae63f2658058ff7577dc8742d4b9213620ba0eef"
    },
    {
      "id": "reader-03",
      "mode": "reader",
      "file": "reader-03.mp3",
      "seconds": 11.455102,
      "cues": [
        {
          "start": 0,
          "end": 6.1807709750566895,
          "text": "父親溫柔地告訴他，誠實不在於錢的多少，也不在於有沒有人看見。"
        },
        {
          "start": 6.530770975056689,
          "end": 11.105102040816327,
          "text": "誠實是自己心中的原則，不是做給別人看的美德。"
        }
      ],
      "sha256": "86cbe82c835fb5017bd89700c8f4b9060536f92453f63a0d9ff3ce922eb354c3"
    }
